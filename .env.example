# Copy this file to .env and fill in your own credentials.
# DO NOT commit the resulting .env to version control.

# === VLM backbone (Gemini-compatible OpenAI endpoint) ===
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# === LLM reasoner (SiliconFlow / Qwen) ===
SILICONFLOW_API_KEY="YOUR_SILICONFLOW_API_KEY"

# === Habitat dataset / logging paths ===
DATASET_ROOT="/path/to/data"
LOG_DIR="/path/to/logs/"

# === Habitat verbosity ===
MAGNUM_LOG=quiet
GLOG_minloglevel=4
HABITAT_SIM_LOG=quiet
HABITAT_LOG_LEVEL=error
